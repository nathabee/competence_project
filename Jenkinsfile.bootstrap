def cfg = [:] 

pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'PREPARE_SHARED_PATHS',
            defaultValue: false,
            description: 'Create/update sav, media, staticfiles paths and project symlinks.'
        )
        booleanParam(
            name: 'RESET_DB',
            defaultValue: false,
            description: 'Drop and recreate the application database.'
        )
        booleanParam(
            name: 'CLEAR_MEDIA',
            defaultValue: false,
            description: 'Remove all files under the media target directory.'
        )
        booleanParam(
            name: 'CLEAR_STATICFILES',
            defaultValue: false,
            description: 'Remove all files under the staticfiles target directory.'
        )
    }

    environment {
        PROJECT_PATH = "/home/nathabee/competence_project"
        PROJECT_OWNER = "nathabee"
        PROJECT_GROUP = "www-data"
        PROJECT_SAV = "/home/nathabee/sav"
        VENV_PATH = "/home/nathabee/competence_project/venv"
        MEDIA_TARGET = "/var/www/competence_project/media"
        STATIC_FILES_PATH = "/var/www/competence_project/staticfiles"
        NODE_BIN = "/home/nathabee/.nvm/versions/node/v20.20.2/bin"
        PROJECT_ENV_FILE = "/home/nathabee/competence_project/.env"

        PATH = "${NODE_BIN}:${env.PATH}"
        timestamp = new Date().format('yyyyMMdd_HHmmss')
        BACKUPDIR = "${PROJECT_SAV}/competence_project_${timestamp}"
    }
 

    stages {

        stage('Load Project .env') {
            steps {
                script {
                    def envText = sh(
                        script: """
                            set +x
                            set -e
                            test -f "${env.PROJECT_ENV_FILE}" || {
                                echo "ERROR: Missing ${env.PROJECT_ENV_FILE}" >&2
                                exit 1
                            }

                            set -a
                            . "${env.PROJECT_ENV_FILE}"
                            set +a

                            for key in DBNAME CI_DEPLOY_ENV CI_UPDATE_DEPLOY_TREE CI_FRONTEND_ENV_FILE CI_FRONTEND_BUILD_CMD CI_RUN_EXTERNAL_SMOKE; do
                                value=\$(eval "printf '%s' \\"\\\${\$key:-}\\"")
                                if [ -z "\$value" ]; then
                                    echo "ERROR: Missing \$key in ${env.PROJECT_ENV_FILE}" >&2
                                    exit 1
                                fi
                                printf '%s=%s\\n' "\$key" "\$value"
                            done

                            value=\$(eval "printf '%s' \\"\\\${CI_INSTALL_FRONTEND_DEPS:-}\\"")
                            printf '%s=%s\\n' "CI_INSTALL_FRONTEND_DEPS" "\$value"
                        """,
                        returnStdout: true
                    ).trim()

                    cfg.clear()

                    envText.split("\\r?\\n").each { line ->
                        def idx = line.indexOf("=")
                        if (idx > 0) {
                            def key = line.substring(0, idx)
                            def value = line.substring(idx + 1)
                            cfg[key] = value
                        }
                    }

                    def requiredKeys = [
                        'DBNAME',
                        'CI_DEPLOY_ENV',
                        'CI_UPDATE_DEPLOY_TREE',
                        'CI_FRONTEND_ENV_FILE',
                        'CI_FRONTEND_BUILD_CMD',
                        'CI_RUN_EXTERNAL_SMOKE'
                    ]

                    requiredKeys.each { key ->
                        if (!cfg.containsKey(key) || cfg[key] == null || cfg[key].trim() == '') {
                            error("Missing ${key} in ${env.PROJECT_ENV_FILE}")
                        }
                    }

                    if (!cfg.CI_INSTALL_FRONTEND_DEPS?.trim()) {
                        cfg.CI_INSTALL_FRONTEND_DEPS = 'false'
                    }

                    def frontendBasePath = sh(
                        script: """
                            set +x
                            set -e

                            FRONTEND_ENV_PATH='${env.PROJECT_PATH}/competence-app/${cfg.CI_FRONTEND_ENV_FILE}'

                            test -f "\$FRONTEND_ENV_PATH" || {
                                echo "ERROR: Missing frontend env file \$FRONTEND_ENV_PATH" >&2
                                exit 1
                            }

                            set -a
                            . "\$FRONTEND_ENV_PATH"
                            set +a

                            printf '%s' "\${NEXT_PUBLIC_BASE_PATH:-}"
                        """,
                        returnStdout: true
                    ).trim()

                    if (!frontendBasePath) {
                        frontendBasePath = '/'
                    } else {
                        if (!frontendBasePath.startsWith('/')) {
                            frontendBasePath = "/${frontendBasePath}"
                        }
                        if (!frontendBasePath.endsWith('/')) {
                            frontendBasePath = "${frontendBasePath}/"
                        }
                    }

                    cfg.NEXT_PUBLIC_BASE_PATH = frontendBasePath

                    echo "Project .env loaded successfully."
                    echo "Frontend base path resolved to: ${cfg.NEXT_PUBLIC_BASE_PATH}"
                }
            }
        }

        stage('BackUp') {
            steps {
                script {
                    sh """
                        set -e
                        mkdir -p ${PROJECT_SAV}
                        cp -r ${PROJECT_PATH} ${BACKUPDIR}
                        mysqldump --defaults-extra-file=/var/lib/jenkins/.my.cnf --databases ${cfg.DBNAME} > '${BACKUPDIR}/db_backup_${timestamp}.sql'
                    """
                    echo "Backup of project directory created at ${BACKUPDIR}"
                    echo "MySQL database backup created."
                }
            }
        }

 

        stage('Stop Services') {
            steps {
                script {
                    sh """
                        set +e
                        sudo systemctl stop gunicorn
                        sudo systemctl stop npm-app
                        exit 0
                    """
                }
            }
        }

        stage('Manual Confirmation') {
            when {
                expression {
                    return params.PREPARE_SHARED_PATHS || params.RESET_DB || params.CLEAR_MEDIA || params.CLEAR_STATICFILES
                }
            }
            steps {
                input message: "Bootstrap will modify the environment. Confirm that you want to continue."
            }
        }

        stage('Reset Database') {
            when {
                expression { return params.RESET_DB }
            }
            steps {
                script {
                    sh """
                        set -e
                        mysql --defaults-extra-file=/var/lib/jenkins/.my.cnf -e 'DROP DATABASE IF EXISTS `${cfg.DBNAME}`; CREATE DATABASE `${cfg.DBNAME}`;'
                    """
                }
            }
        }

        stage('Clear Media') {
            when {
                expression { return params.CLEAR_MEDIA }
            }
            steps {
                script {
                    sh """
                        set -e
                        test -d "${MEDIA_TARGET}" || {
                            echo "ERROR: Missing media target ${MEDIA_TARGET}" >&2
                            exit 1
                        }
                        find "${MEDIA_TARGET}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                        ls -ld "${MEDIA_TARGET}"
                    """
                }
            }
        }

        stage('Clear Static Files') {
            when {
                expression { return params.CLEAR_STATICFILES }
            }
            steps {
                script {
                    sh """
                        set -e
                        test -d "${STATIC_FILES_PATH}" || {
                            echo "ERROR: Missing staticfiles target ${STATIC_FILES_PATH}" >&2
                            exit 1
                        }
                        find "${STATIC_FILES_PATH}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                        ls -ld "${STATIC_FILES_PATH}"
                    """
                }
            }
        }

        stage('Prepare Shared Paths') {
            when {
                expression { return params.PREPARE_SHARED_PATHS }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH} 
                        ./tools/setup_environment.sh --install --ci \
                          --project-path ${PROJECT_PATH} \
                          --project-owner ${PROJECT_OWNER} \
                          --project-group ${PROJECT_GROUP} \
                          --sav-path ${PROJECT_SAV} \
                          --media-target ${MEDIA_TARGET} \
                          --static-target ${STATIC_FILES_PATH} \
                          --prepare-shared-paths
                    """
                }
            }
        }

        stage('Summary') {
            steps {
                echo 'Bootstrap completed. No deploy/build/migrate/test/start was performed.'
                echo 'Run the normal Jenkinsfile pipeline afterward for the real deployment flow.'
            }
        }
    }

    post {
        success {
            echo 'Bootstrap/reset completed successfully.'
        }
        failure {
            echo 'Bootstrap/reset failed.'
        }
    }
}