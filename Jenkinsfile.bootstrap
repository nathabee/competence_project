def cfg = [:]

pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'RESET_DB',
            defaultValue: false,
            description: 'Drop and recreate the application database.'
        )
        booleanParam(
            name: 'CLEAR_MEDIA',
            defaultValue: false,
            description: 'Remove all files under the media target directory.'
        )
        booleanParam(
            name: 'CLEAR_STATICFILES',
            defaultValue: false,
            description: 'Remove all files under the staticfiles target directory.'
        )
        booleanParam(
            name: 'RUN_MIGRATE',
            defaultValue: false,
            description: 'Run Django migrations after reset/cleanup.'
        )
        booleanParam(
            name: 'COPY_DATA_INIT',
            defaultValue: false,
            description: 'Run copy_data_init.'
        )
        booleanParam(
            name: 'POPULATE_DATA_INIT',
            defaultValue: false,
            description: 'Run populate_data_init.'
        )
        booleanParam(
            name: 'CREATE_GROUPS',
            defaultValue: false,
            description: 'Run create_groups_and_permissions.'
        )
        booleanParam(
            name: 'POPULATE_TEACHER',
            defaultValue: false,
            description: 'Run populate_teacher.'
        )
        booleanParam(
            name: 'POPULATE_TRANSLATION',
            defaultValue: false,
            description: 'Run populate_translation.'
        )
        booleanParam(
            name: 'ENSURE_CI_USER',
            defaultValue: false,
            description: 'Run ensure_ci_user.'
        )
        booleanParam(
            name: 'COLLECTSTATIC',
            defaultValue: false,
            description: 'Run collectstatic after initialization.'
        )
    }

    environment {
        PROJECT_PATH = "/home/nathabee/competence_project"
        BACKEND_PATH = "/home/nathabee/competence_project/backend"
        PROJECT_OWNER = "nathabee"
        PROJECT_GROUP = "www-data"
        PROJECT_SAV = "/home/nathabee/sav"
        VENV_PATH = "/home/nathabee/competence_project/backend/venv"
        MEDIA_TARGET = "/var/www/competence_project/media"
        STATIC_FILES_PATH = "/var/www/competence_project/staticfiles"
        NODE_BIN = "/home/nathabee/.nvm/versions/node/v20.20.2/bin"
        PROJECT_ENV_FILE = "/home/nathabee/competence_project/.env"

        PATH = "${NODE_BIN}:${env.PATH}"
        timestamp = new Date().format('yyyyMMdd_HHmmss')
        BACKUPDIR = "${PROJECT_SAV}/competence_project_${timestamp}"
    }

    stages {

        stage('Load Project .env') {
            steps {
                script {
                    def envText = sh(
                        script: """
                            set +x
                            set -e
                            test -f "${env.PROJECT_ENV_FILE}" || {
                                echo "ERROR: Missing ${env.PROJECT_ENV_FILE}" >&2
                                exit 1
                            }

                            set -a
                            . "${env.PROJECT_ENV_FILE}"
                            set +a

                            for key in DBNAME CI_DEPLOY_ENV CI_UPDATE_DEPLOY_TREE CI_FRONTEND_ENV_FILE CI_FRONTEND_BUILD_CMD CI_RUN_EXTERNAL_SMOKE; do
                                value=\$(eval "printf '%s' \\"\\\${\$key:-}\\"")
                                if [ -z "\$value" ]; then
                                    echo "ERROR: Missing \$key in ${env.PROJECT_ENV_FILE}" >&2
                                    exit 1
                                fi
                                printf '%s=%s\\n' "\$key" "\$value"
                            done

                            value=\$(eval "printf '%s' \\"\\\${CI_INSTALL_FRONTEND_DEPS:-}\\"")
                            printf '%s=%s\\n' "CI_INSTALL_FRONTEND_DEPS" "\$value"
                        """,
                        returnStdout: true
                    ).trim()

                    cfg.clear()

                    envText.split("\\r?\\n").each { line ->
                        def idx = line.indexOf("=")
                        if (idx > 0) {
                            def key = line.substring(0, idx)
                            def value = line.substring(idx + 1)
                            cfg[key] = value
                        }
                    }

                    def requiredKeys = [
                        'DBNAME',
                        'CI_DEPLOY_ENV',
                        'CI_UPDATE_DEPLOY_TREE',
                        'CI_FRONTEND_ENV_FILE',
                        'CI_FRONTEND_BUILD_CMD',
                        'CI_RUN_EXTERNAL_SMOKE'
                    ]

                    requiredKeys.each { key ->
                        if (!cfg.containsKey(key) || cfg[key] == null || cfg[key].trim() == '') {
                            error("Missing ${key} in ${env.PROJECT_ENV_FILE}")
                        }
                    }

                    if (!cfg.CI_INSTALL_FRONTEND_DEPS?.trim()) {
                        cfg.CI_INSTALL_FRONTEND_DEPS = 'false'
                    }

                    echo "Project .env loaded successfully."
                }
            }
        }

        stage('BackUp') {
            steps {
                script {
                    sh """
                        set -e
                        mkdir -p '${env.PROJECT_SAV}'
                        cp -r '${env.PROJECT_PATH}' '${env.BACKUPDIR}'
                        mysqldump \
                          --defaults-extra-file=/var/lib/jenkins/.my.cnf \
                          --no-tablespaces \
                          --databases '${cfg.DBNAME}' \
                          > '${env.BACKUPDIR}/db_backup_${env.timestamp}.sql'
                        test -s '${env.BACKUPDIR}/db_backup_${env.timestamp}.sql'
                    """
                    echo "Backup of project directory created at ${env.BACKUPDIR}"
                    echo "MySQL database backup created."
                }
            }
        }

        stage('Manual Confirmation') {
            when {
                expression {
                    return params.RESET_DB ||
                           params.CLEAR_MEDIA ||
                           params.CLEAR_STATICFILES ||
                           params.RUN_MIGRATE ||
                           params.COPY_DATA_INIT ||
                           params.POPULATE_DATA_INIT ||
                           params.CREATE_GROUPS ||
                           params.POPULATE_TEACHER ||
                           params.POPULATE_TRANSLATION ||
                           params.ENSURE_CI_USER ||
                           params.COLLECTSTATIC
                }
            }
            steps {
                input message: "Bootstrap will modify the application state. Confirm that you want to continue."
            }
        }

        stage('Stop Services') {
            steps {
                script {
                    sh """
                        set -e
                        sudo systemctl daemon-reload
                        sudo systemctl stop gunicorn || true
                        sudo systemctl stop npm-app || true
                    """
                }
            }
        }

        stage('Debug Script Versions') {
            steps {
                script {
                    sh '''
                        set -e

                        echo "Workspace directory: $WORKSPACE"
                        echo "Project path: $PROJECT_PATH"

                        echo
                        echo "Workspace setup_environment.sh:"
                        ls -l "$WORKSPACE/tools/setup_environment.sh"
                        sha256sum "$WORKSPACE/tools/setup_environment.sh"

                        echo
                        echo "Project setup_environment.sh:"
                        ls -l "$PROJECT_PATH/tools/setup_environment.sh"
                        sha256sum "$PROJECT_PATH/tools/setup_environment.sh"

                        echo
                        echo "Workspace collect_db_values_if_needed:"
                        grep -n "collect_db_values_if_needed" "$WORKSPACE/tools/setup_environment.sh" || true

                        echo
                        echo "Project collect_db_values_if_needed:"
                        grep -n "collect_db_values_if_needed" "$PROJECT_PATH/tools/setup_environment.sh" || true

                        echo
                        echo "Project DB fallback markers:"
                        grep -n 'project_env_file=' "$PROJECT_PATH/tools/setup_environment.sh" || true
                        grep -n 'DB_NAME="\${DB_NAME:-\${DBNAME:-}}"' "$PROJECT_PATH/tools/setup_environment.sh" || true 
                    '''
                }
            }
        }

        stage('Reset Database') {
            when {
                expression { return params.RESET_DB }
            }
            steps {
                script {
                    sh '''
                        set +x
                        set -e
                        cd "$PROJECT_PATH"

                        test -f "$PROJECT_ENV_FILE" || {
                            echo "ERROR: Missing $PROJECT_ENV_FILE" >&2
                            exit 1
                        }

                        ./tools/setup_environment.sh \
                        --apply --ci \
                        --project-path "$PROJECT_PATH" \
                        --backend-path "$BACKEND_PATH" \
                        --venv-path "$VENV_PATH" \
                        --reset-db
                    '''
                }
            }
        }

        stage('Clear Media') {
            when {
                expression { return params.CLEAR_MEDIA }
            }
            steps {
                script {
                    sh """
                        set -e
                        test -d "${MEDIA_TARGET}" || {
                            echo "ERROR: Missing media target ${MEDIA_TARGET}" >&2
                            exit 1
                        }
                        find "${MEDIA_TARGET}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                        ls -ld "${MEDIA_TARGET}"
                    """
                }
            }
        }

        stage('Clear Static Files') {
            when {
                expression { return params.CLEAR_STATICFILES }
            }
            steps {
                script {
                    sh """
                        set -e
                        test -d "${STATIC_FILES_PATH}" || {
                            echo "ERROR: Missing staticfiles target ${STATIC_FILES_PATH}" >&2
                            exit 1
                        }
                        find "${STATIC_FILES_PATH}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                        ls -ld "${STATIC_FILES_PATH}"
                    """
                }
            }
        }

        stage('Run Migrate') {
            when {
                expression { return params.RUN_MIGRATE }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd '${env.PROJECT_PATH}'
                        ./tools/setup_django.sh \
                          --setup --ci \
                          --project-path '${env.PROJECT_PATH}' \
                          --backend-path '${env.BACKEND_PATH}' \
                          --venv-path '${env.VENV_PATH}' \
                          --migrate
                    """
                }
            }
        }

        stage('Copy Data Init') {
            when {
                expression { return params.COPY_DATA_INIT }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd '${env.PROJECT_PATH}'
                        ./tools/setup_django.sh \
                          --setup --ci \
                          --project-path '${env.PROJECT_PATH}' \
                          --backend-path '${env.BACKEND_PATH}' \
                          --venv-path '${env.VENV_PATH}' \
                          --copy-data-init
                    """
                }
            }
        }

        stage('Populate Data Init') {
            when {
                expression { return params.POPULATE_DATA_INIT }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd '${env.PROJECT_PATH}'
                        ./tools/setup_django.sh \
                          --setup --ci \
                          --project-path '${env.PROJECT_PATH}' \
                          --backend-path '${env.BACKEND_PATH}' \
                          --venv-path '${env.VENV_PATH}' \
                          --populate-data-init
                    """
                }
            }
        }

        stage('Create Groups') {
            when {
                expression { return params.CREATE_GROUPS }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd '${env.PROJECT_PATH}'
                        ./tools/setup_django.sh \
                          --setup --ci \
                          --project-path '${env.PROJECT_PATH}' \
                          --backend-path '${env.BACKEND_PATH}' \
                          --venv-path '${env.VENV_PATH}' \
                          --create-groups
                    """
                }
            }
        }

        stage('Populate Teacher') {
            when {
                expression { return params.POPULATE_TEACHER }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd '${env.PROJECT_PATH}'
                        ./tools/setup_django.sh \
                          --setup --ci \
                          --project-path '${env.PROJECT_PATH}' \
                          --backend-path '${env.BACKEND_PATH}' \
                          --venv-path '${env.VENV_PATH}' \
                          --populate-teacher
                    """
                }
            }
        }

        stage('Populate Translation') {
            when {
                expression { return params.POPULATE_TRANSLATION }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd '${env.PROJECT_PATH}'
                        ./tools/setup_django.sh \
                          --setup --ci \
                          --project-path '${env.PROJECT_PATH}' \
                          --backend-path '${env.BACKEND_PATH}' \
                          --venv-path '${env.VENV_PATH}' \
                          --populate-translation
                    """
                }
            }
        }

        stage('Ensure CI Django User') {
            when {
                expression { return params.ENSURE_CI_USER }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd '${env.PROJECT_PATH}'
                        ./tools/setup_django.sh \
                          --setup --ci \
                          --project-path '${env.PROJECT_PATH}' \
                          --backend-path '${env.BACKEND_PATH}' \
                          --venv-path '${env.VENV_PATH}' \
                          --ensure-ci-user
                    """
                }
            }
        }

        stage('Collect Static Files') {
            when {
                expression { return params.COLLECTSTATIC }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd '${env.PROJECT_PATH}'
                        ./tools/setup_django.sh \
                          --setup --ci \
                          --project-path '${env.PROJECT_PATH}' \
                          --backend-path '${env.BACKEND_PATH}' \
                          --venv-path '${env.VENV_PATH}' \
                          --collectstatic
                    """
                }
            }
        }

        stage('Summary') {
            steps {
                echo 'Bootstrap completed.'
                echo 'This pipeline is for reset, reinitialization, and cleanup operations.'
                echo 'Run the normal deploy pipeline afterward only if you still need a full deploy/build/test flow.'
            }
        }
    }

    post {
        success {
            echo 'Bootstrap/reset completed successfully.'
        }
        failure {
            echo 'Bootstrap/reset failed.'
        }
    }
}