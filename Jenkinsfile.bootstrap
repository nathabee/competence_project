pipeline {
    agent any

    parameters {
        booleanParam(name: 'PREPARE_MEDIA', defaultValue: false, description: 'Create/check production media layout and media symlink.')
        booleanParam(name: 'RESET_DB', defaultValue: false, description: 'Drop and recreate competencedb.')
        booleanParam(name: 'INIT_DB', defaultValue: false, description: 'Run Django init data tasks.')
        booleanParam(name: 'POPULATE_TRANSLATION', defaultValue: false, description: 'Run populate_translation.')
        booleanParam(name: 'RESET_PASSWORDS', defaultValue: false, description: 'Reset example Django user passwords from .env DEFAULT_USER_PASSWORD.')
    }

    environment {
        PROJECT_PATH = "/home/nathabee/competence_project"
        PROJECT_SAV = "/home/nathabee/sav"
        VENV_PATH = "/home/nathabee/competence_project/venv"
        STATIC_FILES_PATH = "/var/www/competence_project/staticfiles"
        NODE_BIN = "/home/nathabee/.nvm/versions/node/v20.20.2/bin"
        PATH = "${NODE_BIN}:${env.PATH}"
        timestamp = new Date().format('yyyyMMdd_HHmmss')
        BACKUPDIR = "${PROJECT_SAV}/competence_project_${timestamp}"
    }

    stages {

        stage('BackUp') {
            steps {
                script {
                    sh """
                        set -e
                        mkdir -p ${PROJECT_SAV}
                        cp -r ${PROJECT_PATH} ${BACKUPDIR}
                        mysqldump --defaults-extra-file=/var/lib/jenkins/.my.cnf --databases competencedb > '${BACKUPDIR}/db_backup_${timestamp}.sql'
                    """
                    echo "Backup of project directory created at ${BACKUPDIR}"
                    echo "MySQL database backup created."
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'main']],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [[$class: 'WipeWorkspace']],
                    userRemoteConfigs: [[url: 'https://github.com/nathabee/competence_project.git']]
                ])
            }
        }

        stage('Update Repository') {
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH}
                        sudo -u nathabee git fetch origin
                        sudo -u nathabee git reset --hard origin/main
                    """
                }
            }
        }

        stage('Stop Services') {
            steps {
                script {
                    sh """
                        set +e
                        sudo systemctl stop gunicorn
                        sudo systemctl stop npm-app
                        exit 0
                    """
                }
            }
        }

        stage('Manual Confirmation for DB Reset') {
            when {
                expression { return params.RESET_DB }
            }
            steps {
                input message: "RESET_DB is enabled. Confirm that competencedb must be dropped and recreated."
            }
        }

        stage('Check Tool Versions') {
            steps {
                script {
                    sh """
                        set -e
                        echo "PATH=$PATH"
                        which node
                        node -v
                        which npm
                        npm -v
                    """
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH}
                        chmod +x tools/setup_django.sh tools/reset-django-pwd.sh tools/setup_django_migration.sh tools/setup_django_loaddata.sh
                        ./tools/setup_django.sh --setup --ci --project-path ${PROJECT_PATH} --venv-path ${VENV_PATH} --install-requirements
                    """
                    sh """
                        set -e
                        cd ${PROJECT_PATH}/competence-app
                        npm install
                    """
                }
            }
        }

        stage('Prepare Media Layout') {
            when {
                expression { return params.PREPARE_MEDIA }
            }
            steps {
                script {
                    sh """
                        set -e

                        sudo mkdir -p /var/www/competence_project/media/origin/competence/header_icons
                        sudo mkdir -p /var/www/competence_project/media/origin/competence/png
                        sudo mkdir -p /var/www/competence_project/media/competence/header_icons
                        sudo mkdir -p /var/www/competence_project/media/competence/png

                        sudo chown -R nathabee:www-data /var/www/competence_project
                        sudo find /var/www/competence_project -type d -exec chmod 2775 {} \\;
                        sudo find /var/www/competence_project -type f -exec chmod 664 {} \\;

                        cd ${PROJECT_PATH}

                        if [ -L media ]; then
                            ln -sfn /var/www/competence_project/media media
                        elif [ ! -e media ]; then
                            ln -s /var/www/competence_project/media media
                        else
                            echo "ERROR: ${PROJECT_PATH}/media exists and is not a symlink."
                            echo "Refusing to modify it automatically in Jenkins."
                            exit 1
                        fi

                        ls -ld media /var/www/competence_project/media
                    """
                }
            }
        }

        stage('Reset Database') {
            when {
                expression { return params.RESET_DB }
            }
            steps {
                script {
                    sh """
                        set -e
                        mysql --defaults-extra-file=/var/lib/jenkins/.my.cnf -e 'DROP DATABASE IF EXISTS competencedb; CREATE DATABASE competencedb;'
                    """
                }
            }
        }

        stage('Migrate Database') {
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH}
                        ./tools/setup_django.sh --setup --ci --project-path ${PROJECT_PATH} --venv-path ${VENV_PATH} --migrate
                    """
                }
            }
        }

        stage('Initialize Django Data') {
            when {
                expression { return params.INIT_DB || params.RESET_DB }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH}
                        ./tools/setup_django.sh --setup --ci --project-path ${PROJECT_PATH} --venv-path ${VENV_PATH} --copy-data-init --populate-data-init --create-groups --populate-teacher
                    """
                }
            }
        }

        stage('Populate Translation') {
            when {
                expression { return params.POPULATE_TRANSLATION }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH}
                        ./tools/setup_django.sh --setup --ci --project-path ${PROJECT_PATH} --venv-path ${VENV_PATH} --populate-translation
                    """
                }
            }
        }

        stage('Reset Django Passwords') {
            when {
                expression { return params.RESET_PASSWORDS }
            }
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH}
                        ./tools/setup_django.sh --setup --ci --project-path ${PROJECT_PATH} --venv-path ${VENV_PATH} --reset-passwords
                    """
                }
            }
        }

        stage('Build Frontend') {
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH}/competence-app
                        npm run build
                    """
                }
            }
        }

        stage('Collect Static Files') {
            steps {
                script {
                    sh """
                        set -e
                        cd ${PROJECT_PATH}
                        ./tools/setup_django.sh --setup --ci --project-path ${PROJECT_PATH} --venv-path ${VENV_PATH} --collectstatic
                    """
                }
            }
        }

        stage('Start Services') {
            steps {
                script {
                    sh """
                        set -e
                        sudo systemctl start gunicorn
                        sudo systemctl start npm-app
                    """
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    sh """
                        set -e
                        . ${VENV_PATH}/bin/activate
                        cd ${PROJECT_PATH}
                        python manage.py test competence.tests.test_integration_workflow
                    """
                    sh """
                        set -e
                        cd ${PROJECT_PATH}/competence-app
                        export NODE_ENV=test
                        npm run test
                    """
                }
            }
        }

        stage('Health Check (internal)') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'competence-app-teacher-id', usernameVariable: 'TEACHER_USER', passwordVariable: 'TEACHER_PASS')]) {
                        def accessToken = sh(
                            script: '''
                                set +x
                                curl -fsS -X POST \
                                -H "Content-Type: application/json" \
                                -H "X-Forwarded-Proto: https" \
                                -d "{\"username\":\"$TEACHER_USER\",\"password\":\"$TEACHER_PASS\"}" \
                                http://127.0.0.1:8080/api/token/ | jq -r .access
                            ''',
                            returnStdout: true
                        ).trim()

                        sh """
                            set -e
                            test -n "${accessToken}"
                            test "${accessToken}" != "null"
                            curl -fsS \
                              -H "Authorization: Bearer ${accessToken}" \
                              -H "X-Forwarded-Proto: https" \
                              http://127.0.0.1:8080/api/
                            curl -fsSI http://127.0.0.1:3000/
                        """
                    }
                }
            }
        }

        stage('Smoke Check (external HTTPS)') {
            steps {
                sh """
                    set -e
                    curl -fsSI https://competence.nathabee.de/api/
                    curl -fsSI https://competence.nathabee.de/admin/
                    curl -fsSI https://competence.nathabee.de/
                """
            }
        }
    }

    post {
        success {
            echo 'Bootstrap/reset deployment successful!'
        }
        failure {
            echo 'Bootstrap/reset deployment failed.'
        }
    }
}