# The prefix NEXT_PUBLIC_ is required for environment variables that need to be exposed to the client side 


NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_API_URL=https://competence.nathabee.de/api/
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_ADMIN_URL=https://competence.nathabee.de/admin/
NEXT_PUBLIC_MEDIA_URL=https://competence.nathabee.de/media 




# Secret keys like JWT_SECRET_KEY should only be accessed on the server side and thus don’t need the prefix.